{
    "name": "vds-verify",
    "version": "2.7.0",
    "license": "MIT",
    "main": "expo-router/entry",
    "scripts": {
        "postinstall": "node scripts/fix-expo-modules-jsi.cjs",
        "start": "node scripts/dev.mjs start",
        "android": "node scripts/dev.mjs android",
        "ios": "node scripts/dev.mjs ios",
        "lint": "eslint .",
        "format": "prettier --ignore-path ./.gitignore --write \"**/*.+(js|ts|tsx|json)\"",
        "typecheck": "tsc --noEmit",
        "screenshots:ios": "node scripts/screenshots/run.mjs ios",
        "screenshots:android": "node scripts/screenshots/run.mjs android",
        "screenshots:all": "node scripts/screenshots/run.mjs all",
        "screenshots:build:ios": "node scripts/screenshots/build.mjs ios",
        "screenshots:build:android": "node scripts/screenshots/build.mjs android"
    },
    "dependencies": {
        "@expo/ui": "~58.0.3",
        "@expo/vector-icons": "^15.0.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-picker/picker": "2.11.4",
        "buffer": "^6.0.3",
        "crypto-js": "^4.2.0",
        "expo": "~58.0.0-preview.4",
        "expo-application": "~58.0.1",
        "expo-asset": "~58.0.3",
        "expo-blur": "~58.0.0",
        "expo-build-properties": "~58.0.4",
        "expo-camera": "~58.0.1",
        "expo-constants": "~58.0.3",
        "expo-dev-client": "~58.0.3",
        "expo-device": "~58.0.0",
        "expo-file-system": "~58.0.0",
        "expo-font": "~58.0.1",
        "expo-glass-effect": "~58.0.0",
        "expo-haptics": "~58.0.1",
        "expo-linking": "~58.0.3",
        "expo-localization": "~58.0.0",
        "expo-navigation-bar": "~58.0.0",
        "expo-print": "~58.0.0",
        "expo-router": "~58.0.4",
        "expo-sharing": "~58.0.6",
        "expo-splash-screen": "~58.0.0",
        "expo-status-bar": "~58.0.0",
        "expo-system-ui": "~58.0.1",
        "prop-types": "^15.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0-rc.1",
        "react-native-animatable": "^1.4.0",
        "react-native-gesture-handler": "~3.2.1",
        "react-native-reanimated": "4.6.0",
        "react-native-safe-area-context": "~5.9.1",
        "react-native-screens": "~4.28.0",
        "react-native-webview": "14.0.1",
        "react-native-worklets": "0.12.2"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^9.39.1",
        "@types/react": "~19.3.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.9.0",
        "prettier": "^3.8.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "buffer",
                    "crypto-js",
                    "prop-types"
                ]
            }
        }
    },
    "private": false
}
